# --- App ---
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- Local docker-compose ---
DATABASE_URL=postgresql+asyncpg://pa_app:pa_app@localhost:5432/personal_assistant
DATABASE_ADMIN_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/personal_assistant
REDIS_URL=redis://localhost:6379/0

# Legacy SQLite CLI only (not used by the SaaS API)
DATABASE_PATH=data/assistant.db

# --- Supabase (D1) ---
# Data API keys (sb_publishable_ / sb_secret_). Never ship the secret key to Next.js.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# --- Clerk (D1) ---
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/signup

PUBLIC_APP_URL=http://localhost:3000

# --- Stripe (dormant unless STRIPE_ENABLED=true) ---
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASIC_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=

# --- Vercel AI Gateway (server-only; never shown in the product) ---
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=
AI_ROUTE_SIMPLE=
AI_ROUTE_DEFAULT=
AI_ROUTE_LONG_CONTEXT=

# --- Encryption for integration tokens (D2 Slice 4) ---
# Fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=

# --- Gmail OAuth (D2 Slice 4; leave empty to keep connect 503) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/api/integrations/gmail/callback
PUBLIC_API_URL=http://localhost:8000

# --- Telegram (D2 Slice 4; leave empty to keep connect 503) ---
TELEGRAM_BOT_TOKEN=

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
