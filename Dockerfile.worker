# Railway Arq worker. Same image contents as the API; do not run migrations here.
FROM python:3.12-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app:/app/src
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

COPY backend/pyproject.toml backend/README.md backend/requirements.txt backend/alembic.ini backend/main.py ./
COPY backend/src ./src
COPY backend/app ./app
COPY backend/migrations ./migrations

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/* \
    && pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir .

CMD ["python", "-m", "arq", "app.workers.arq_worker.WorkerSettings"]
