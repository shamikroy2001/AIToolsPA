# D1 staging freeze — Core Platform only.
# Copy values into Railway (API + worker) and Vercel. Never commit filled copies.
# Stripe is dormant: keep STRIPE_ENABLED=false and leave Stripe keys empty.
# Slice 4 Gmail/Telegram env is optional — omit to keep connect paused (503).

ENVIRONMENT=staging
LOG_LEVEL=INFO
PUBLIC_APP_URL=https://YOUR-APP.vercel.app
CORS_ORIGINS=https://YOUR-APP.vercel.app

# Supabase Data API — Railway API only, never NEXT_PUBLIC_ on Vercel.
# New keys (Settings → API Keys): sb_publishable_… / sb_secret_…
# Send them as the apikey header. Prefer the secret key on the server.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_
SUPABASE_SECRET_KEY=sb_secret_

# Postgres wire protocol (Alembic + Clerk RLS). Still required.
# If the password contains @ : / #, URL-encode it (e.g. @ → %40).
DATABASE_URL=postgresql+asyncpg://pa_app:PASSWORD@HOST:5432/postgres
DATABASE_ADMIN_URL=postgresql+asyncpg://postgres:PASSWORD@HOST:5432/postgres
REDIS_URL=redis://default:PASSWORD@HOST:6379

# Clerk (staging instance). JWKS must match the issuer.
CLERK_SECRET_KEY=
CLERK_ISSUER=https://your-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json

# Stripe — disconnected / dormant. Code remains; do not send live keys.
STRIPE_ENABLED=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_BASIC_PRICE_ID=
STRIPE_PRO_PRICE_ID=
STRIPE_PREMIUM_PRICE_ID=

# Vercel AI Gateway — Railway only, never NEXT_PUBLIC_
AI_GATEWAY_API_KEY=
AI_GATEWAY_BASE_URL=https://ai-gateway.vercel.sh/v1
AI_ROUTE_SIMPLE=
AI_ROUTE_DEFAULT=
AI_ROUTE_LONG_CONTEXT=

# Slice 4 Gmail/Telegram env — API for connect; **also copy onto the worker** for Slice 5 jobs.
# Authorized Google redirect: https://YOUR-RAILWAY-API.up.railway.app/api/integrations/gmail/callback
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REDIRECT_URI=https://YOUR-RAILWAY-API.up.railway.app/api/integrations/gmail/callback
# PUBLIC_API_URL=https://YOUR-RAILWAY-API.up.railway.app
# CREDENTIAL_ENCRYPTION_KEY=
# TELEGRAM_BOT_TOKEN=
